# ─── Telegram ───────────────────────────────────────────────────────────────
# Токен от @BotFather. ОБЯЗАТЕЛЬНО. Если токен утёк — отзовите и получите новый.
BOT_TOKEN=

# Ваш числовой Telegram ID (узнать: @userinfobot). Без него админка не работает.
ADMIN_ID=

# Username бота БЕЗ @ — нужен для возврата после оплаты
BOT_USERNAME=

# Username поддержки БЕЗ @
SUPPORT_USERNAME=

# Ссылка на группу с отзывами (кнопка «⭐ Отзывы»).
# Можно так: https://t.me/my_reviews  или  t.me/my_reviews  или  @my_reviews
REVIEWS_URL=

# ─── База данных ────────────────────────────────────────────────────────────
# Локально: data/shop.db   На хостинге: /app/data/shop.db
DB_PATH=data/shop.db

# ─── Логика магазина (можно менять без правки кода) ─────────────────────────
# Стоимость доставки, ₽
DELIVERY_COST=389
# Доставка бесплатная, если брелоков на эту сумму и больше (без учёта доставки), ₽
FREE_DELIVERY_SUM=1000
# Скидка действует от стольких брелоков (штук)
DISCOUNT_FROM_QTY=2
# Размер скидки, %
DISCOUNT_PERCENT=10

# ─── Связь с ботом ВКонтакте (необязательно, см. SYNC_API.md) ────────────────
# Пусто = API для бота ВК выключено. Токен — длинная случайная строка (от 32 символов),
# тот же токен указывается в боте ВК. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_TOKEN=
# Порт API. Если пусто — берётся PORT (его обычно задаёт хостинг), иначе 8080
SYNC_API_PORT=

# ─── ЮKassa (необязательно) ─────────────────────────────────────────────────
# Пусто = оплата отключена, заказы приходят сразу в статусе «Новый».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
